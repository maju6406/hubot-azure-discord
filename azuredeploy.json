{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "One-click deploy template for Hubot with Discord adapter on Azure, using hubot-azure-brain for persistence"
  },
  "parameters": {
    "siteName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Azure Web App that hosts the hubot instance"
      }
    },
    "hostingPlanName": {
      "type": "string",
      "metadata": {
        "description": "Name of the App Service plan for the web app"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for deploying all resources"
      }
    },
    "pricingTier": {
      "type": "string",
      "allowedValues": [
        "Free",
        "Shared",
        "Basic",
        "Standard"
      ],
      "defaultValue": "Free",
      "metadata": {
        "description": "App Service pricing tier"
      }
    },
    "enableAlwaysOn": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable Always On (not available on Free/Shared tiers)"
      }
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Storage account name for hubot brain persistence via hubot-azure-brain"
      }
    },
    "storageAccountType": {
      "type": "string",
      "allowedValues": [
        "Standard_LRS",
        "Standard_GRS",
        "Standard_ZRS"
      ],
      "defaultValue": "Standard_LRS",
      "metadata": {
        "description": "Replication strategy for the storage account"
      }
    },
    "discordBotToken": {
      "type": "securestring",
      "metadata": {
        "description": "Discord bot token from https://discord.com/developers/applications"
      }
    },
    "hubotName": {
      "type": "string",
      "defaultValue": "hubot",
      "metadata": {
        "description": "Display name for the hubot instance"
      }
    },
    "repoUrl": {
      "type": "string",
      "metadata": {
        "description": "URL of your forked repository"
      }
    },
    "branch": {
      "type": "string",
      "defaultValue": "main",
      "metadata": {
        "description": "Git branch to deploy from"
      }
    },
    "enableApplicationInsights": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable Application Insights for monitoring and logging"
      }
    }
  },
  "variables": {
    "tierToSku": {
      "Free": "F1",
      "Shared": "D1",
      "Basic": "B1",
      "Standard": "S1"
    },
    "resolvedSku": "[variables('tierToSku')[parameters('pricingTier')]]",
    "storageApi": "2022-09-01",
    "webApi": "2022-03-01",
    "appInsightsName": "[concat(parameters('siteName'), '-insights')]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "name": "[parameters('storageAccountName')]",
      "apiVersion": "[variables('storageApi')]",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "[parameters('storageAccountType')]"
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "name": "[parameters('hostingPlanName')]",
      "apiVersion": "[variables('webApi')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[variables('resolvedSku')]"
      },
      "properties": {
        "name": "[parameters('hostingPlanName')]",
        "numberOfWorkers": 1
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "name": "[variables('appInsightsName')]",
      "apiVersion": "2020-02-02",
      "location": "[parameters('location')]",
      "condition": "[parameters('enableApplicationInsights')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "Request_Source": "rest",
        "RetentionInDays": 90,
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "name": "[parameters('siteName')]",
      "apiVersion": "[variables('webApi')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('hostingPlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('hostingPlanName'))]",
        "siteConfig": {
          "alwaysOn": "[parameters('enableAlwaysOn')]",
          "httpLoggingEnabled": true,
          "detailedErrorLoggingEnabled": true,
          "requestTracingEnabled": true
        }
      },
      "resources": [
        {
          "type": "config",
          "name": "appsettings",
          "apiVersion": "[variables('webApi')]",
          "dependsOn": [
            "[resourceId('Microsoft.Web/sites', parameters('siteName'))]",
            "[if(parameters('enableApplicationInsights'), resourceId('Microsoft.Insights/components', variables('appInsightsName')), resourceId('Microsoft.Web/sites', parameters('siteName')))]"
          ],
          "properties": {
            "WEBSITE_NODE_DEFAULT_VERSION": "~18",
            "HUBOT_ADAPTER": "discord",
            "HUBOT_DISCORD_TOKEN": "[parameters('discordBotToken')]",
            "HUBOT_BRAIN_AZURE_CONNSTRING": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageAccountName'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), variables('storageApi')).keys[0].value, ';EndpointSuffix=core.windows.net')]",
            "HUBOT_NAME": "[parameters('hubotName')]",
            "APPINSIGHTS_INSTRUMENTATIONKEY": "[if(parameters('enableApplicationInsights'), reference(concat('Microsoft.Insights/components/', variables('appInsightsName')), '2020-02-02').InstrumentationKey, '')]",
            "APPLICATIONINSIGHTS_CONNECTION_STRING": "[if(parameters('enableApplicationInsights'), reference(concat('Microsoft.Insights/components/', variables('appInsightsName')), '2020-02-02').ConnectionString, '')]",
            "ApplicationInsightsAgent_EXTENSION_VERSION": "[if(parameters('enableApplicationInsights'), '~3', '')]",
            "XDT_MicrosoftApplicationInsights_Mode": "[if(parameters('enableApplicationInsights'), 'recommended', '')]"
          }
        },
        {
          "type": "sourcecontrols",
          "name": "web",
          "apiVersion": "[variables('webApi')]",
          "dependsOn": [
            "[resourceId('Microsoft.Web/sites', parameters('siteName'))]",
            "[resourceId('Microsoft.Web/sites/config', parameters('siteName'), 'appsettings')]"
          ],
          "properties": {
            "repoUrl": "[parameters('repoUrl')]",
            "branch": "[parameters('branch')]",
            "isManualIntegration": true
          }
        }
      ]
    }
  ],
  "outputs": {
    "webAppUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('siteName')), variables('webApi')).defaultHostName)]",
      "metadata": {
        "description": "URL of the deployed web app"
      }
    },
    "applicationInsightsName": {
      "type": "string",
      "value": "[if(parameters('enableApplicationInsights'), variables('appInsightsName'), 'Not Enabled')]",
      "metadata": {
        "description": "Name of the Application Insights resource"
      }
    },
    "storageAccountName": {
      "type": "string",
      "value": "[parameters('storageAccountName')]",
      "metadata": {
        "description": "Name of the storage account for hubot brain"
      }
    }
  }
}