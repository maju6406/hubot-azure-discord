{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.40.2.10011",
      "templateHash": "18042053680005681546"
    }
  },
  "parameters": {
    "siteName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Azure Web App that hosts the hubot instance"
      }
    },
    "hostingPlanName": {
      "type": "string",
      "defaultValue": "[format('{0}-plan', parameters('siteName'))]",
      "metadata": {
        "description": "Name of the App Service plan for the web app"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for deploying all resources"
      }
    },
    "pricingTier": {
      "type": "string",
      "defaultValue": "Free",
      "allowedValues": [
        "Free",
        "Shared",
        "Basic",
        "Standard"
      ],
      "metadata": {
        "description": "App Service pricing tier"
      }
    },
    "enableAlwaysOn": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable Always On (not available on Free/Shared tiers)"
      }
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Storage account name for hubot brain persistence via hubot-azure-brain"
      }
    },
    "storageAccountType": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [
        "Standard_LRS",
        "Standard_GRS",
        "Standard_ZRS"
      ],
      "metadata": {
        "description": "Replication strategy for the storage account"
      }
    },
    "discordBotToken": {
      "type": "securestring",
      "metadata": {
        "description": "Discord bot token from https://discord.com/developers/applications"
      }
    },
    "hubotName": {
      "type": "string",
      "defaultValue": "hubot",
      "metadata": {
        "description": "Display name for the hubot instance"
      }
    },
    "repoUrl": {
      "type": "string",
      "metadata": {
        "description": "URL of your forked repository"
      }
    },
    "branch": {
      "type": "string",
      "defaultValue": "main",
      "metadata": {
        "description": "Git branch to deploy from"
      }
    }
  },
  "variables": {
    "tierToSku": {
      "Free": "F1",
      "Shared": "D1",
      "Basic": "B1",
      "Standard": "S1"
    },
    "resolvedSku": "[variables('tierToSku')[parameters('pricingTier')]]",
    "appInsightsName": "[format('{0}-insights', parameters('siteName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2022-09-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "[parameters('storageAccountType')]"
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-03-01",
      "name": "[parameters('hostingPlanName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "[variables('resolvedSku')]"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "Request_Source": "rest",
        "RetentionInDays": 90,
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-03-01",
      "name": "[parameters('siteName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('hostingPlanName'))]",
        "siteConfig": {
          "linuxFxVersion": "NODE|20-lts",
          "alwaysOn": "[parameters('enableAlwaysOn')]",
          "httpLoggingEnabled": true,
          "detailedErrorLoggingEnabled": true,
          "requestTracingEnabled": true
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('hostingPlanName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2022-03-01",
      "name": "[format('{0}/{1}', parameters('siteName'), 'appsettings')]",
      "properties": {
        "WEBSITE_NODE_DEFAULT_VERSION": "~20",
        "HUBOT_ADAPTER": "discord",
        "HUBOT_DISCORD_TOKEN": "[parameters('discordBotToken')]",
        "HUBOT_BRAIN_AZURE_CONNSTRING": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix=core.windows.net', parameters('storageAccountName'), listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2022-09-01').keys[0].value)]",
        "HUBOT_NAME": "[parameters('hubotName')]",
        "APPINSIGHTS_INSTRUMENTATIONKEY": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').InstrumentationKey]",
        "APPLICATIONINSIGHTS_CONNECTION_STRING": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]",
        "ApplicationInsightsAgent_EXTENSION_VERSION": "~3",
        "XDT_MicrosoftApplicationInsights_Mode": "recommended"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
        "[resourceId('Microsoft.Web/sites', parameters('siteName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/sourcecontrols",
      "apiVersion": "2022-03-01",
      "name": "[format('{0}/{1}', parameters('siteName'), 'web')]",
      "properties": {
        "repoUrl": "[parameters('repoUrl')]",
        "branch": "[parameters('branch')]",
        "isManualIntegration": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('siteName'))]",
        "[resourceId('Microsoft.Web/sites/config', parameters('siteName'), 'appsettings')]"
      ]
    }
  ],
  "outputs": {
    "webAppUrl": {
      "type": "string",
      "metadata": {
        "description": "URL of the deployed web app"
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('siteName')), '2022-03-01').defaultHostName)]"
    },
    "applicationInsightsName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Application Insights resource"
      },
      "value": "[variables('appInsightsName')]"
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Name of the storage account for hubot brain"
      },
      "value": "[parameters('storageAccountName')]"
    }
  }
}